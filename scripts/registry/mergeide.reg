Windows Registry Editor Version 5.00

; MergeIDE — Comprehensive IDE controller registry patch for V2V migration
; Source: Microsoft KB 314082 (https://mskb.pkisolutions.com/kb/314082)
; Adapted for offline application via hivexregedit.
;
; Placeholders:
;   __CONTROLSET__ = replaced at runtime with active ControlSet (e.g. ControlSet001)
;   HKEY_LOCAL_MACHINE\SYSTEM\ prefix stripped for hivexregedit hive-relative paths
;
; The fix_ide_controller.sh script handles ControlSet detection and placeholder substitution.

; ====================================================================
; CriticalDeviceDatabase entries
; ====================================================================

; --- Standard IDE ATA/ATAPI Channels ---

[__CONTROLSET__\Control\CriticalDeviceDatabase\primary_ide_channel]
"ClassGUID"="{4D36E96A-E325-11CE-BFC1-08002BE10318}"
"Service"="atapi"

[__CONTROLSET__\Control\CriticalDeviceDatabase\secondary_ide_channel]
"ClassGUID"="{4D36E96A-E325-11CE-BFC1-08002BE10318}"
"Service"="atapi"

[__CONTROLSET__\Control\CriticalDeviceDatabase\*pnp0600]
"ClassGUID"="{4D36E96A-E325-11CE-BFC1-08002BE10318}"
"Service"="atapi"

; --- Aztech IDE Controller ---
[__CONTROLSET__\Control\CriticalDeviceDatabase\*azt0502]
"ClassGUID"="{4D36E96A-E325-11CE-BFC1-08002BE10318}"
