; ====================================================================
; Service driver entries (ensure boot-start with correct metadata)
; ====================================================================

; --- Atapi driver (requires atapi.sys in drivers directory) ---
[__CONTROLSET__\Services\atapi]
"ErrorControl"=dword:00000001
"Group"="SCSI miniport"
"Start"=dword:00000000
"Tag"=dword:00000019
"Type"=dword:00000001
"DisplayName"="Standard IDE/ESDI Hard Disk Controller"

; --- IntelIde driver (requires intelide.sys in drivers directory) ---
[__CONTROLSET__\Services\IntelIde]
"ErrorControl"=dword:00000001
"Group"="System Bus Extender"
"Start"=dword:00000000
"Tag"=dword:00000004
"Type"=dword:00000001

; --- PCIIde driver (requires pciide.sys and pciidex.sys in drivers directory) ---
[__CONTROLSET__\Services\PCIIde]
"ErrorControl"=dword:00000001
"Group"="System Bus Extender"
"Start"=dword:00000000
"Tag"=dword:00000003
"Type"=dword:00000001
